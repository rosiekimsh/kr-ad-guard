{
  "manifest_version": 3,
  "name": "도박배너 차단기 (KR Ad Guard)",
  "version": "0.5.0",
  "description": "한국 사이트의 불법 도박·카지노 배너를 구조 분석 + 온디바이스 OCR로 판별해 숨깁니다. 이미지·방문기록은 외부로 전송되지 않습니다.",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "offscreen",
    "webNavigation",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "scoring.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "도박배너 차단기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/i16.png",
      "32": "icons/i32.png",
      "48": "icons/i48.png"
    }
  },
  "icons": {
    "16": "icons/i16.png",
    "48": "icons/i48.png",
    "128": "icons/i128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}